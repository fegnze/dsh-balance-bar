{
  "name": "dsh-balance-bar",
  "version": "0.1.1",
  "license": "MIT",
  "author": "fegnze",
  "keywords": ["dsh-plugin", "deepseek-harness", "balance", "usage"],
  "repository": { "type": "git", "url": "git+https://github.com/fegnze/dsh-balance-bar.git" },
  "homepage": "https://github.com/fegnze/dsh-balance-bar#readme",
  "bugs": { "url": "https://github.com/fegnze/dsh-balance-bar/issues" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "type": "module",
  "description": "在侧栏账号入口上方常驻显示 DeepSeek 充值余额",
  "exports": { ".": "./src/host.mjs", "./client": "./src/client.js", "./package.json": "./package.json" },
  "files": ["src", "cordis.patch.yml", "README.md", "README.zh.md"],
  "peerDependencies": { "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2" },
  "peerDependenciesMeta": { "@deepseek-ai/dsh-app-boot": { "optional": true } },
  "engines": { "node": ">=22", "dsh": "0.2.0-rc.2" },
  "dsh": { "manifestVersion": 1, "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-slots", "@deepseek-ai/dsh-client-ui-sidebar"] } },
  "scripts": { "test": "node --test test/*.test.mjs" }
}
